# 이 파일을 복사해서 .env 를 만들고 값을 채운다. (.env 는 절대 커밋하지 않는다)
# 실제 값은 디스코드 DM으로만 공유한다.

# BE(FastAPI) 서버 주소
VITE_API_URL=http://localhost:8000

# Supabase (로그인) — Project URL 과 anon key 만. service_role 키는 절대 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 카카오 JavaScript 키 (카톡 초대코드 공유)
VITE_KAKAO_JS_KEY=

# 로컬 개발용: true 면 로그인 없이 모든 화면을 볼 수 있다 (BE 연결 전까지)
VITE_SKIP_AUTH=true
