# 이 파일을 복사해서 .env 를 만들고 값을 채운다. (.env 는 절대 커밋하지 않는다)
# 실제 값은 디스코드 DM으로만 공유한다.

# BE(FastAPI) 서버 주소
VITE_API_URL=http://localhost:8000/api/v1

# Supabase (로그인) — Project URL 과 publishable key(sb_publishable_…) 만. service_role · secret 키는 절대 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 카카오 JavaScript 키 (카톡 초대코드 공유)
VITE_KAKAO_JS_KEY=

# Web Push 공개키. BE의 VAPID_PUBLIC_KEY와 같은 값이며 비밀키는 FE에 넣지 않는다.
VITE_VAPID_PUBLIC_KEY=

# 로컬 개발용: true 면 로그인 없이 모든 화면을 볼 수 있다 (BE 연결 전까지)
VITE_SKIP_AUTH=true

# 진짜 API 로 부를 기능 (쉼표로 구분, 나머지는 가짜 서버). 비워 두면 모두 가짜 서버 (기본)
#   기능: users · invitations · recipes · manuals · assistantChat · handover · schedule · payroll · all(모두)
#   예) VITE_REAL_API=users,invitations
VITE_REAL_API=
